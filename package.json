{
  "name": "codesheaf",
  "displayName": "CodeSheaf — LLM Context Bundler",
  "description": "Bundle files, selections and their import dependencies into LLM-ready context (Markdown / XML / plain text) with token estimates — right from your editor.",
  "version": "1.1.0",
  "publisher": "codesheaf-tools",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/tubibibo/codesheaf.git"
  },
  "bugs": {
    "url": "https://github.com/tubibibo/codesheaf/issues"
  },
  "homepage": "https://github.com/tubibibo/codesheaf#readme",
  "keywords": [
    "llm",
    "ai",
    "context",
    "prompt",
    "chatgpt",
    "claude",
    "gemini",
    "copy",
    "bundler"
  ],
  "categories": [
    "Other",
    "Programming Languages"
  ],
  "engines": {
    "vscode": "^1.96.0",
    "node": ">=20"
  },
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "capabilities": {
    "virtualWorkspaces": false
  },
  "contributes": {
    "commands": [
      {
        "command": "codesheaf.copyFile",
        "title": "Copy Active File as Context",
        "category": "CodeSheaf"
      },
      {
        "command": "codesheaf.copyFileWithImports",
        "title": "Copy Active File + Import Dependencies",
        "category": "CodeSheaf"
      },
      {
        "command": "codesheaf.copySelection",
        "title": "Copy Selection as Context",
        "category": "CodeSheaf"
      },
      {
        "command": "codesheaf.previewBundle",
        "title": "Preview Context Bundle (Active File)",
        "category": "CodeSheaf"
      },
      {
        "command": "codesheaf.copyFiles",
        "title": "Copy as LLM Context",
        "category": "CodeSheaf"
      },
      {
        "command": "codesheaf.previewFiles",
        "title": "Preview Context Bundle (Explorer Selection)",
        "category": "CodeSheaf"
      },
      {
        "command": "codesheaf.copyWithFormat",
        "title": "Copy as Context (Choose Format)…",
        "category": "CodeSheaf"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "codesheaf.copySelection",
          "when": "editorHasSelection",
          "group": "9_codesheaf"
        },
        {
          "command": "codesheaf.copyFile",
          "when": "resourceScheme == file || resourceScheme == untitled",
          "group": "9_codesheaf"
        },
        {
          "command": "codesheaf.copyFileWithImports",
          "when": "resourceScheme == file || resourceScheme == untitled",
          "group": "9_codesheaf"
        }
      ],
      "explorer/context": [
        {
          "command": "codesheaf.copyFiles",
          "when": "explorerResourceIsFolder || resourceScheme == file",
          "group": "9_codesheaf"
        },
        {
          "command": "codesheaf.previewFiles",
          "when": "explorerResourceIsFolder || resourceScheme == file",
          "group": "9_codesheaf"
        }
      ]
    },
    "keybindings": [
      {
        "command": "codesheaf.copyFileWithImports",
        "key": "ctrl+alt+c",
        "mac": "cmd+alt+c",
        "when": "editorTextFocus"
      }
    ],
    "configuration": {
      "title": "CodeSheaf",
      "properties": {
        "codesheaf.format": {
          "type": "string",
          "default": "markdown",
          "enum": [
            "markdown",
            "xml",
            "plain"
          ],
          "enumDescriptions": [
            "Markdown with fenced code blocks (great for chat UIs)",
            "XML with CDATA sections (structured, machine-parseable)",
            "Plain text with separators (maximum compatibility)"
          ],
          "description": "Output format of the woven context bundle."
        },
        "codesheaf.includeLineNumbers": {
          "type": "boolean",
          "default": false,
          "description": "Prefix every code line with a `N | ` line-number marker."
        },
        "codesheaf.includeTree": {
          "type": "boolean",
          "default": true,
          "description": "Include a file tree of the bundled files at the top."
        },
        "codesheaf.maxImportDepth": {
          "type": "number",
          "default": 3,
          "minimum": 0,
          "maximum": 10,
          "description": "How deep to follow import declarations when weaving. 0 disables import following."
        },
        "codesheaf.maxFileSizeKB": {
          "type": "number",
          "default": 256,
          "minimum": 1,
          "description": "Files larger than this size (in KiB) are skipped."
        },
        "codesheaf.respectGitignore": {
          "type": "boolean",
          "default": true,
          "description": "Honor `.gitignore` files in the workspace roots when picking files."
        },
        "codesheaf.exclude": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Extra exclude globs; applied after the built-in defaults and .gitignore rules."
        },
        "codesheaf.secretScan": {
          "type": "string",
          "default": "warn",
          "enum": [
            "off",
            "warn"
          ],
          "enumDescriptions": [
            "No secret checking.",
            "Scan the bundle for likely credentials and ask for confirmation before copying."
          ],
          "description": "Scan bundles for likely credentials before they leave the machine. `warn` scans at copy time and shows a confirmation dialog listing what was found (choose Copy anyway to proceed); `off` disables scanning entirely. This is a conservative heuristic — it can miss secrets and can raise false positives — not a replacement for a dedicated scanner."
        },
        "codesheaf.resolveTsconfigAliases": {
          "type": "boolean",
          "default": true,
          "description": "Read each workspace root's tsconfig.json paths/baseUrl (literal and single-star patterns) when following TypeScript/JavaScript imports. The extends chain is not followed; unmatched or unreadable tsconfigs keep the old skip behavior."
        },
        "codesheaf.statusBar.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show the live token estimate in the status bar."
        },
        "codesheaf.maxTotalTokens": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "description": "Estimated total token budget for a bundle. Once the running estimate reaches it, no further discovered files are included (breadth-first admission order: directory expansion and import closure; explicitly picked files are never withheld). 0 disables the budget."
        },
        "codesheaf.taskHeader": {
          "type": "string",
          "default": "",
          "description": "Optional task reminder woven after the title line and before the file tree (markdown quote block, XML <task>, plain TASK: section). Leave empty to render nothing."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -p . --watch",
    "typecheck": "tsc -p . --noEmit",
    "typecheck:tests": "tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:smoke": "node ./scripts/smoke-adapter.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "npm run typecheck && npm run typecheck:tests && npm run lint && npm run test && npm run compile && npm run test:smoke",
    "package": "npm run build && vsce package",
    "clean": "node ./scripts/clean.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.10.0",
    "@types/vscode": "1.96.0",
    "@vitest/coverage-v8": "^4.1.12",
    "@vscode/vsce": "^3.2.0",
    "eslint": "^10.14.0",
    "globals": "^16.0.0",
    "prettier": "^3.4.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.7",
    "vitest": "^4.1.12"
  },
  "private": true,
  "icon": "media/icon.png"
}
